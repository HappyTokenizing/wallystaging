      "permanent": true
    },
    {
      "source": "/brand/",
      "destination": "/media-kit/",
      "permanent": true
    },
    {
      "source": "/brandkit",
      "destination": "/media-kit/",
      "permanent": true
    },
    {
      "source": "/brandkit/",
      "destination": "/media-kit/",
      "permanent": true
    },
    {
      "source": "/eco",
      "destination": "/ecosystem/",
      "permanent": true
    },
    {
      "source": "/eco/",
      "destination": "/ecosystem/",
