      "permanent": true
    },
    {
      "source": "/research/rwa-perps-sep-2026",
      "destination": "/research/rwa-perps-sep-2026/",
      "permanent": true
    },
    {
      "source": "/research/market-structure-aug-2026",
      "destination": "/research/market-structure-aug-2026/",
      "permanent": true
    },
    {
      "source": "/guide",
      "destination": "/guide/",
      "permanent": true
    },
    {
      "source": "/1",
      "destination": "/1/",
      "permanent": true
    },
    {
      "source": "/2",
      "destination": "/2/",
      "permanent": true
    },
    {
      "source": "/3",
      "destination": "/3/",
      "permanent": true
    },
    {
      "source": "/foundation",
