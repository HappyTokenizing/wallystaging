    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/brand/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/brand/rwa-foundation-logos.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"RWA-Foundation-Logos.zip\""
        }
      ]
    },
    {
      "source": "/assets/brand/rwa-foundation-brand-guidelines.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"RWA-Foundation-Brand-Guidelines.pdf\""
        }
      ]
    }
  ],
  "outputDirectory": "."
