{
  "crons": [
    {
      "path": "/api/collect-news",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/collect-news.js": {
      "maxDuration": 60
    },
    "api/news.js": {
      "maxDuration": 60
    },
    "api/company-news.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/members",
      "destination": "/members/",
      "permanent": true
    },
    {
      "source": "/ecosystem",
      "destination": "/ecosystem/",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/news/",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/jobs/",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/learn/",
      "permanent": true
    },
    {
      "source": "/wally-nft",
      "destination": "/wally-nft/",
      "permanent": true
    },
    {
      "source": "/meet",
      "destination": "/meet/",
      "permanent": true
    },
    {
      "source": "/newsletter",
      "destination": "/newsletter/",
      "permanent": true
    },
    {
      "source": "/media-kit",
      "destination": "/media-kit/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
